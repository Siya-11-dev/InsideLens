# InsideLens configuration. All values are optional: with no Azure keys the
# system runs fully offline using deterministic local inference.
INSIDELENS_HOST=127.0.0.1
INSIDELENS_PORT=8000

# LLM provider: "local" (default, no keys) or "azure"
INSIDELENS_LLM_PROVIDER=local
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Translation provider: "local" (default) or "azure"
INSIDELENS_TRANSLATOR_PROVIDER=local
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Storage / data platform: "memory" (default), "azuresql" or "fabric"
INSIDELENS_STORE_BACKEND=memory
AZURE_SQL_CONNECTION_STRING=
INSIDELENS_AZURE_SQL_TABLE=insidelens_insights
AZURE_STORAGE_CONNECTION_STRING=
INSIDELENS_FABRIC_CONTAINER=insidelens
INSIDELENS_EXPORT_DIR=exports

# Live data source: "synthetic" (default) or "eventhub"
INSIDELENS_DATA_SOURCE=synthetic
AZURE_EVENTHUB_CONNECTION_STRING=
AZURE_EVENTHUB_NAME=
AZURE_EVENTHUB_CONSUMER_GROUP=$Default

# Simulator
INSIDELENS_MATCH_SEED=20261015
INSIDELENS_HOME_TEAM=MUN
INSIDELENS_AWAY_TEAM=MCI
INSIDELENS_STREAM_SPEED=60.0
